# Copier ce fichier en .dev.vars (jamais commité) pour lancer l'appli en local avec "npm run dev".
# En ligne, ces valeurs se posent avec : npx wrangler secret put NOM

# Clé "Consumer Key" de developer.ticketmaster.com
TICKETMASTER_KEY=
# Clé API de resend.com (commence par re_)
RESEND_KEY=
# Adresse qui reçoit les alertes (plusieurs possibles, séparées par des virgules)
MAIL_DESTINATAIRE=
# Code d'accès à l'appli : long et difficile à deviner (ex. 4 mots au hasard)
ACCESS_CODE=
# Optionnel : identifiant d'application Bandsintown (laisser vide sinon)
BANDSINTOWN_APP_ID=
